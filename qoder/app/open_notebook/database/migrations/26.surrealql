-- Migration 26: research memory tables for 研续 ResearchMemory
-- Adds scope bindings, memory drafts, artifact links, operations, traces, and reports.

-- Scope binding: one Notebook → one PowerContext Scope
DEFINE TABLE IF NOT EXISTS research_scope_binding SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS notebook_id ON TABLE research_scope_binding TYPE record<notebook>;
DEFINE FIELD IF NOT EXISTS deployment_uuid ON TABLE research_scope_binding TYPE string;
DEFINE FIELD IF NOT EXISTS scope_id ON TABLE research_scope_binding TYPE string;
DEFINE FIELD IF NOT EXISTS status ON TABLE research_scope_binding TYPE string DEFAULT "provisioning";
DEFINE FIELD IF NOT EXISTS created_at ON TABLE research_scope_binding DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE research_scope_binding DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_research_scope_binding_notebook ON TABLE research_scope_binding COLUMNS notebook_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_research_scope_binding_scope ON TABLE research_scope_binding COLUMNS scope_id;

-- Memory draft: candidates before user confirmation
DEFINE TABLE IF NOT EXISTS research_memory_draft SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS notebook_id ON TABLE research_memory_draft TYPE record<notebook>;
DEFINE FIELD IF NOT EXISTS draft_type ON TABLE research_memory_draft TYPE string;
DEFINE FIELD IF NOT EXISTS content ON TABLE research_memory_draft TYPE string;
DEFINE FIELD IF NOT EXISTS epistemic_status ON TABLE research_memory_draft TYPE string DEFAULT "user_statement";
DEFINE FIELD IF NOT EXISTS workflow_status ON TABLE research_memory_draft TYPE string DEFAULT "not_applicable";
DEFINE FIELD IF NOT EXISTS evidence_refs ON TABLE research_memory_draft TYPE option<array<object>> DEFAULT [];
DEFINE FIELD IF NOT EXISTS draft_version ON TABLE research_memory_draft TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS status ON TABLE research_memory_draft TYPE string DEFAULT "draft";
DEFINE FIELD IF NOT EXISTS mode ON TABLE research_memory_draft TYPE string DEFAULT "manual";
DEFINE FIELD IF NOT EXISTS created_at ON TABLE research_memory_draft DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE research_memory_draft DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_research_draft_notebook ON TABLE research_memory_draft COLUMNS notebook_id;
DEFINE INDEX IF NOT EXISTS idx_research_draft_status ON TABLE research_memory_draft COLUMNS status;

-- Artifact link: maps business item_id to PowerContext artifact
DEFINE TABLE IF NOT EXISTS research_memory_link SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS item_id ON TABLE research_memory_link TYPE string;
DEFINE FIELD IF NOT EXISTS notebook_id ON TABLE research_memory_link TYPE record<notebook>;
DEFINE FIELD IF NOT EXISTS scope_id ON TABLE research_memory_link TYPE string;
DEFINE FIELD IF NOT EXISTS artifact_id ON TABLE research_memory_link TYPE string;
DEFINE FIELD IF NOT EXISTS kind ON TABLE research_memory_link TYPE string;
DEFINE FIELD IF NOT EXISTS latest_revision ON TABLE research_memory_link TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS latest_etag ON TABLE research_memory_link TYPE option<string>;
DEFINE FIELD IF NOT EXISTS latest_state_version ON TABLE research_memory_link TYPE int DEFAULT 0;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE research_memory_link DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE research_memory_link DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_research_link_item ON TABLE research_memory_link COLUMNS item_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_research_link_notebook ON TABLE research_memory_link COLUMNS notebook_id;
DEFINE INDEX IF NOT EXISTS idx_research_link_artifact ON TABLE research_memory_link COLUMNS artifact_id;

-- Operation log: dedup and audit trail
DEFINE TABLE IF NOT EXISTS research_memory_operation SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS operation_id ON TABLE research_memory_operation TYPE string;
DEFINE FIELD IF NOT EXISTS request_fingerprint ON TABLE research_memory_operation TYPE option<string>;
DEFINE FIELD IF NOT EXISTS draft_id ON TABLE research_memory_operation TYPE option<record<research_memory_draft>>;
DEFINE FIELD IF NOT EXISTS notebook_id ON TABLE research_memory_operation TYPE record<notebook>;
DEFINE FIELD IF NOT EXISTS operation_type ON TABLE research_memory_operation TYPE string;
DEFINE FIELD IF NOT EXISTS status ON TABLE research_memory_operation TYPE string DEFAULT "pending";
DEFINE FIELD IF NOT EXISTS result_refs ON TABLE research_memory_operation TYPE option<object>;
DEFINE FIELD IF NOT EXISTS error_message ON TABLE research_memory_operation TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE research_memory_operation DEFAULT time::now() VALUE $before OR time::now();
DEFINE INDEX IF NOT EXISTS idx_research_op_id ON TABLE research_memory_operation COLUMNS operation_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_research_op_notebook ON TABLE research_memory_operation COLUMNS notebook_id;

-- Trace: per-request audit log
DEFINE TABLE IF NOT EXISTS research_trace SCHEMALESS;
DEFINE FIELD IF NOT EXISTS trace_id ON TABLE research_trace TYPE string;
DEFINE FIELD IF NOT EXISTS session_id ON TABLE research_trace TYPE option<string>;
DEFINE FIELD IF NOT EXISTS notebook_id ON TABLE research_trace TYPE record<notebook>;
DEFINE FIELD IF NOT EXISTS events ON TABLE research_trace TYPE option<array<object>> DEFAULT [];
DEFINE FIELD IF NOT EXISTS memory_refs ON TABLE research_trace TYPE option<array<object>> DEFAULT [];
DEFINE FIELD IF NOT EXISTS evidence_refs ON TABLE research_trace TYPE option<array<object>> DEFAULT [];
DEFINE FIELD IF NOT EXISTS duration_ms ON TABLE research_trace TYPE option<int>;
DEFINE FIELD IF NOT EXISTS error_code ON TABLE research_trace TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE research_trace DEFAULT time::now();
DEFINE INDEX IF NOT EXISTS idx_research_trace_id ON TABLE research_trace COLUMNS trace_id UNIQUE;

-- Report: generated meeting reports
DEFINE TABLE IF NOT EXISTS research_report SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS notebook_id ON TABLE research_report TYPE record<notebook>;
DEFINE FIELD IF NOT EXISTS title ON TABLE research_report TYPE option<string>;
DEFINE FIELD IF NOT EXISTS body ON TABLE research_report TYPE string;
DEFINE FIELD IF NOT EXISTS memory_refs ON TABLE research_report TYPE option<array<object>> DEFAULT [];
DEFINE FIELD IF NOT EXISTS evidence_refs ON TABLE research_report TYPE option<array<object>> DEFAULT [];
DEFINE FIELD IF NOT EXISTS model_id ON TABLE research_report TYPE option<string>;
DEFINE FIELD IF NOT EXISTS trace_id ON TABLE research_report TYPE option<string>;
DEFINE FIELD IF NOT EXISTS generated_at ON TABLE research_report DEFAULT time::now() VALUE $before OR time::now();
DEFINE INDEX IF NOT EXISTS idx_research_report_notebook ON TABLE research_report COLUMNS notebook_id;

-- Deployment config singleton (stores deployment_uuid for idempotency)
IF array::len(select * from research_deployment_config) == 0 THEN
    CREATE research_deployment_config SET
        deployment_uuid = rand::uuid(),
        created_at = time::now();
END;
