# 研续 ResearchMemory 部署配置
# 复制此文件为 .env 并填入真实值

# === 数据库 ===
SURREAL_USER=root
SURREAL_PASS=change-me-in-production

# === 应用 ===
API_PORT=5055
FRONTEND_PORT=8502
OPEN_NOTEBOOK_ENCRYPTION_KEY=

# === PowerContext ===
POWERCONTEXT_ACCESS_MODE=disabled
POWERCONTEXT_LOG_LEVEL=info
RESEARCH_POWERCONTEXT_TOKEN=

# === 研究记忆 ===
RESEARCH_MEMORY_ENABLED=true
RESEARCH_POWERCONTEXT_CONNECT_TIMEOUT_SECONDS=2
RESEARCH_POWERCONTEXT_READ_TIMEOUT_SECONDS=8
RESEARCH_MEMORY_CONTEXT_MAX_BYTES=12000
RESEARCH_MEMORY_SEARCH_MODE=text

# === 模型凭据（通过 UI 或 API 配置） ===
# 不在部署文件中存储真实 API Key
